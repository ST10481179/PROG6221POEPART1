<Window x:Class="CyberSecurityChatbot.InputDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Input" Height="150" Width="400" WindowStartupLocation="CenterOwner" ResizeMode="NoResize">
    <Grid Margin="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <TextBlock x:Name="PromptText" Grid.Row="0" Text="Prompt" Margin="0,0,0,6" />
        <TextBox x:Name="ResponseBox" Grid.Row="1" AcceptsReturn="False" />
        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,8,0,0">
            <Button Width="80" Margin="6,0,0,0" Click="Ok_Click">OK</Button>
            <Button Width="80" Margin="6,0,0,0" Click="Cancel_Click">Cancel</Button>
        </StackPanel>
    </Grid>
</Window>