<Window
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:av="http://schemas.microsoft.com/expression/blend/2008" xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" mc:Ignorable="av" x:Class="CyberSecurityChatbot.MainWindow"
        x:ClassModifier="internal"
        Title="Cybersecurity Awareness Bot"
        Height="742"
        Width="1250"
        ResizeMode="NoResize"
        WindowStartupLocation="CenterScreen">
    <Window.Background>
        <LinearGradientBrush EndPoint="0.5,1" StartPoint="0.5,0">
            <GradientStop Color="Black"/>
            <GradientStop Color="#FF0A6C33" Offset="1"/>
        </LinearGradientBrush>
    </Window.Background>
    <Window.BorderBrush>
        <LinearGradientBrush EndPoint="0.5,1" StartPoint="0.5,0">
            <GradientStop Color="Black"/>
            <GradientStop Color="Black" Offset="1"/>
        </LinearGradientBrush>
    </Window.BorderBrush>
    <Grid Margin="12">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="879*"/>
            <ColumnDefinition Width="347*"/>
        </Grid.ColumnDefinitions>
        <Grid.Background>
            <LinearGradientBrush EndPoint="0.5,1" StartPoint="0.5,0">
                <GradientStop Color="Black"/>
                <GradientStop Color="#FF011F4A" Offset="1"/>
            </LinearGradientBrush>
        </Grid.Background>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Border Background="#0F172A" CornerRadius="14" Padding="18" Grid.Row="0" Grid.ColumnSpan="2">
            <StackPanel>
                <TextBlock Text="Cybersecurity Awareness Bot" Foreground="White" FontSize="26" FontWeight="Bold" />
                <TextBlock Text="Ask about passwords, phishing, malware, VPNs, privacy, safe browsing, or online safety." Foreground="#E2E8F0" FontSize="14" Margin="0,8,0,0" />
                <TextBlock Text="The bot uses keyword recognition, memory recall, sentiment-aware replies, and dynamic tips." Foreground="#94A3B8" FontSize="12" Margin="0,6,0,0" />
            </StackPanel>
        </Border>

        <Grid Grid.Row="1" Margin="0,18,0,0" Grid.ColumnSpan="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="3*" />
                <ColumnDefinition Width="1.25*" />
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0" CornerRadius="14" Padding="12" BorderThickness="1">
                <Border.Background>
                    <LinearGradientBrush EndPoint="0.5,1" StartPoint="0.5,0">
                        <GradientStop Color="Black"/>
                        <GradientStop Color="#FF00F34C" Offset="1"/>
                    </LinearGradientBrush>
                </Border.Background>
                <Border.BorderBrush>
                    <LinearGradientBrush EndPoint="0.5,1" StartPoint="0.5,0">
                        <GradientStop Color="Black"/>
                        <GradientStop Color="Black" Offset="1"/>
                    </LinearGradientBrush>
                </Border.BorderBrush>
                <TextBox x:Name="HistoryTextBox"
                         AcceptsReturn="True"
                         IsReadOnly="True"
                         VerticalScrollBarVisibility="Auto"
                         TextWrapping="Wrap"
                         FontFamily="Consolas"
                         FontSize="13"
                         Background="#020617"
                         Foreground="#A7F3D0"
                         BorderThickness="0" Margin="-13,16,23,-13" RenderTransformOrigin="0.519,0.491" Text="" />
            </Border>

            <Border Background="#0F172A" CornerRadius="14" Padding="6" Margin="843,0,0,0" BorderBrush="#CBD5E1" BorderThickness="1" Grid.ColumnSpan="2">
                <TabControl x:Name="MainTabControl" Background="#0F172A" Foreground="White" BorderThickness="0">
                    <TabItem Header="Status">
                        <ScrollViewer VerticalScrollBarVisibility="Auto" Height="476" Margin="-21,0,0,0">
                            <StackPanel Margin="10">
                                <TextBlock Text="Status Panel" Foreground="White" FontSize="16" FontWeight="Bold" Margin="0,0,0,12" Height="24" Width="316" />
                                <TextBlock Text="User Name:" Foreground="#94A3B8" FontSize="12" />
                                <TextBlock x:Name="UserNameText" Text="Not set" Foreground="White" FontSize="14" FontWeight="SemiBold" Margin="0,2,0,10" Height="29" Width="334" />
                                <TextBlock Text="Last Topic:" Foreground="#94A3B8" FontSize="12" />
                                <TextBlock x:Name="LastTopicText" Text="No topic yet" Foreground="White" FontSize="14" FontWeight="SemiBold" Margin="0,2,0,10" Height="43" Width="337" />
                                <TextBlock Text="Interests:" Foreground="#94A3B8" FontSize="12" />
                                <TextBlock x:Name="InterestsText" Text="No interests yet" Foreground="White" FontSize="14" FontWeight="SemiBold" Margin="0,2,0,10" TextWrapping="Wrap" Height="38" Width="333" />
                                <TextBlock Text="Memory Summary:" Foreground="#94A3B8" FontSize="12" Margin="0,10,0,2" Height="28" Width="315" />
                                <ListBox x:Name="MemoryListBox" Background="#020617" Foreground="White" BorderThickness="0" FontFamily="Consolas" FontSize="12" Height="120" av:ItemsSource="{av:SampleData ItemCount=5}" Width="336" />
                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,8,0,0">
                                    <Button x:Name="AddMemoryButton" Content="Add Memory" Width="100" Height="30" Margin="6,0,0,0" Click="AddMemory_Click" />
                                    <Button x:Name="EditMemoryButton" Content="Edit Selected" Width="100" Height="30" Margin="6,0,0,0" Click="EditMemory_Click" />
                                    <Button x:Name="RemoveMemoryButton" Content="Remove Selected" Width="120" Height="30" Margin="6,0,0,0" Click="RemoveMemory_Click" />
                                    <Button x:Name="ClearInterestsButton" Content="Clear Interests" Width="120" Height="30" Margin="6,0,0,0" Click="ClearInterests_Click" />
                                </StackPanel>
                            </StackPanel>
                        </ScrollViewer>
                    </TabItem>
                    <TabItem Header="Tasks">
                        <ScrollViewer VerticalScrollBarVisibility="Auto">
                            <StackPanel Margin="10">
                                <TextBlock Text="Task Assistant" Foreground="White" FontSize="16" FontWeight="Bold" Margin="0,0,0,12" />
                                <TextBlock Text="Title:" Foreground="#94A3B8" FontSize="12" />
                                <TextBox x:Name="TaskTitleTextBox" Height="30" FontSize="13" Margin="0,4,0,10" />
                                <TextBlock Text="Description:" Foreground="#94A3B8" FontSize="12" />
                                <TextBox x:Name="TaskDescriptionTextBox" Height="60" TextWrapping="Wrap" AcceptsReturn="True" FontSize="13" Margin="0,4,0,10" />
                                <TextBlock Text="Reminder (optional):" Foreground="#94A3B8" FontSize="12" />
                                <TextBox x:Name="TaskReminderTextBox" Height="30" FontSize="13" Margin="0,4,0,10" />
                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,4,0,10">
                                    <Button x:Name="AddTaskButton" Content="Add Task" Width="100" Height="30" Margin="6,0,0,0" Click="AddTaskButton_Click" />
                                    <Button x:Name="CompleteTaskButton" Content="Mark Complete" Width="110" Height="30" Margin="6,0,0,0" Click="CompleteTaskButton_Click" />
                                    <Button x:Name="DeleteTaskButton" Content="Delete Task" Width="100" Height="30" Margin="6,0,0,0" Click="DeleteTaskButton_Click" />
                                </StackPanel>
                                <DataGrid x:Name="TaskDataGrid" AutoGenerateColumns="False" Height="250" Background="#020617" Foreground="Black" GridLinesVisibility="None" BorderThickness="0" SelectionMode="Single" SelectionUnit="FullRow" HeadersVisibility="Column" CanUserResizeRows="False" CanUserResizeColumns="True" CanUserSortColumns="False">
                                    <DataGrid.Columns>
                                        <DataGridTextColumn Header="Title" Binding="{Binding Title}" Width="*" />
                                        <DataGridTextColumn Header="Description" Binding="{Binding Description}" Width="2*" />
                                        <DataGridTextColumn Header="Reminder" Binding="{Binding Reminder}" Width="*" />
                                        <DataGridCheckBoxColumn Header="Complete" Binding="{Binding IsComplete}" Width="Auto" />
                                    </DataGrid.Columns>
                                </DataGrid>
                            </StackPanel>
                        </ScrollViewer>
                    </TabItem>
                    <TabItem Header="Quiz">
                        <ScrollViewer VerticalScrollBarVisibility="Auto">
                            <StackPanel Margin="10">
                                <TextBlock Text="Cybersecurity Quiz" Foreground="White" FontSize="16" FontWeight="Bold" Margin="0,0,0,12" />
                                <TextBlock x:Name="QuizQuestionText" TextWrapping="Wrap" Foreground="#E2E8F0" FontSize="14" Margin="0,0,0,14" />
                                <StackPanel>
                                    <RadioButton x:Name="OptionARadio" GroupName="QuizOptions" Foreground="#A7F3D0" FontSize="13" Margin="0,2,0,2" />
                                    <RadioButton x:Name="OptionBRadio" GroupName="QuizOptions" Foreground="#A7F3D0" FontSize="13" Margin="0,2,0,2" />
                                    <RadioButton x:Name="OptionCRadio" GroupName="QuizOptions" Foreground="#A7F3D0" FontSize="13" Margin="0,2,0,2" />
                                    <RadioButton x:Name="OptionDRadio" GroupName="QuizOptions" Foreground="#A7F3D0" FontSize="13" Margin="0,2,0,2" />
                                </StackPanel>
                                <StackPanel Orientation="Horizontal" Margin="0,10,0,10">
                                    <Button x:Name="StartQuizButton" Content="Start Quiz" Width="100" Height="30" Margin="0,0,10,0" Click="StartQuizButton_Click" />
                                    <Button x:Name="SubmitAnswerButton" Content="Submit Answer" Width="120" Height="30" Margin="0,0,10,0" Click="SubmitAnswerButton_Click" />
                                    <Button x:Name="NextQuestionButton" Content="Next Question" Width="120" Height="30" Click="NextQuestionButton_Click" Visibility="Collapsed" />
                                </StackPanel>
                                <TextBlock x:Name="QuizFeedbackText" TextWrapping="Wrap" Foreground="#A7F3D0" FontSize="13" Margin="0,0,0,10" />
                                <TextBlock x:Name="QuizScoreText" Foreground="#94A3B8" FontSize="12" />
                            </StackPanel>
                        </ScrollViewer>
                    </TabItem>
                    <TabItem Header="Activity">
                        <ScrollViewer VerticalScrollBarVisibility="Auto">
                            <StackPanel Margin="10">
                                <TextBlock Text="Activity Log" Foreground="White" FontSize="16" FontWeight="Bold" Margin="0,0,0,12" />
                                <TextBox x:Name="LogTextBox" AcceptsReturn="True" IsReadOnly="True" VerticalScrollBarVisibility="Auto" TextWrapping="Wrap" Background="#020617" Foreground="#A7F3D0" BorderThickness="0" Height="360" FontFamily="Consolas" FontSize="12" />
                                <Button x:Name="ShowMoreLogButton" Content="Show More" Width="100" Height="30" HorizontalAlignment="Right" Margin="0,10,0,0" Click="ShowMoreLogButton_Click" />
                            </StackPanel>
                        </ScrollViewer>
                    </TabItem>
                </TabControl>
            </Border>
        </Grid>

        <Grid Grid.Row="2" Margin="0,18,0,0" Grid.ColumnSpan="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <TextBox x:Name="InputTextBox"
                     Grid.Column="0"
                     Height="46"
                     VerticalContentAlignment="Center"
                     FontSize="14"
                     Padding="8"
                     BorderBrush="#CBD5E1"
                     BorderThickness="1"
                     KeyDown="InputTextBox_KeyDown" />

            <Button x:Name="HelpButton"
                    Grid.Column="1"
                    Width="110"
                    Height="46"
                    Margin="10,0,10,0"
                    Content="Help"
                    Background="#0F172A"
                    Foreground="White"
                    FontWeight="Bold"
                    Click="HelpButton_Click" />

            <Button x:Name="SendButton"
                    Grid.Column="2"
                    Width="130"
                    Height="46"
                    Content="Send"
                    Background="#22C55E"
                    Foreground="White"
                    FontWeight="Bold"
                    Click="SendButton_Click" />
        </Grid>
    </Grid>
</Window>