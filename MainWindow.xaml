<Window x:Class="CyberSecurityChatbot.MainWindow"
        x:ClassModifier="internal"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Cybersecurity Awareness Bot"
        Height="680"
        Width="820"
        ResizeMode="NoResize"
        Background="#F8FAFC"
        WindowStartupLocation="CenterScreen">
    <Grid Margin="12" Background="#F8FAFC">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Border Background="#0F172A" CornerRadius="14" Padding="18" Grid.Row="0">
            <StackPanel>
                <TextBlock Text="Cybersecurity Awareness Bot" Foreground="White" FontSize="26" FontWeight="Bold" />
                <TextBlock Text="Ask about passwords, phishing, malware, VPNs, privacy, safe browsing, or online safety." Foreground="#E2E8F0" FontSize="14" Margin="0,8,0,0" />
                <TextBlock Text="The bot uses keyword recognition, memory recall, sentiment-aware replies, and dynamic tips." Foreground="#94A3B8" FontSize="12" Margin="0,6,0,0" />
            </StackPanel>
        </Border>

        <Grid Grid.Row="1" Margin="0,18,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="3*" />
                <ColumnDefinition Width="1.25*" />
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0" Background="White" CornerRadius="14" Padding="12" BorderBrush="#CBD5E1" BorderThickness="1">
                <TextBox x:Name="HistoryTextBox"
                         AcceptsReturn="True"
                         IsReadOnly="True"
                         VerticalScrollBarVisibility="Auto"
                         TextWrapping="Wrap"
                         FontFamily="Consolas"
                         FontSize="13"
                         Background="#020617"
                         Foreground="#A7F3D0"
                         BorderThickness="0" />
            </Border>

            <Border Grid.Column="1" Background="#0F172A" CornerRadius="14" Padding="14" Margin="14,0,0,0" BorderBrush="#CBD5E1" BorderThickness="1">
                <StackPanel>
                    <TextBlock Text="Status Panel" Foreground="White" FontSize="16" FontWeight="Bold" Margin="0,0,0,12" />
                    <TextBlock Text="User Name:" Foreground="#94A3B8" FontSize="12" />
                    <TextBlock x:Name="UserNameText" Text="Not set" Foreground="White" FontSize="14" FontWeight="SemiBold" Margin="0,2,0,10" />
                    <TextBlock Text="Last Topic:" Foreground="#94A3B8" FontSize="12" />
                    <TextBlock x:Name="LastTopicText" Text="No topic yet" Foreground="White" FontSize="14" FontWeight="SemiBold" Margin="0,2,0,10" />
                    <TextBlock Text="Interests:" Foreground="#94A3B8" FontSize="12" />
                    <TextBlock x:Name="InterestsText" Text="No interests yet" Foreground="White" FontSize="14" FontWeight="SemiBold" Margin="0,2,0,10" TextWrapping="Wrap" />
                    <TextBlock Text="Memory Summary:" Foreground="#94A3B8" FontSize="12" Margin="0,10,0,2" />
                    <ListBox x:Name="MemoryListBox" Background="#020617" Foreground="#A7F3D0" BorderThickness="0" FontFamily="Consolas" FontSize="12" Height="160" />
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,8,0,0">
                        <Button x:Name="AddMemoryButton" Content="Add Memory" Width="100" Height="30" Margin="6,0,0,0" Click="AddMemory_Click" />
                        <Button x:Name="EditMemoryButton" Content="Edit Selected" Width="100" Height="30" Margin="6,0,0,0" Click="EditMemory_Click" />
                        <Button x:Name="RemoveMemoryButton" Content="Remove Selected" Width="120" Height="30" Margin="6,0,0,0" Click="RemoveMemory_Click" />
                        <Button x:Name="ClearInterestsButton" Content="Clear Interests" Width="120" Height="30" Margin="6,0,0,0" Click="ClearInterests_Click" />
                    </StackPanel>
                </StackPanel>
            </Border>
        </Grid>

        <Grid Grid.Row="2" Margin="0,18,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <TextBox x:Name="InputTextBox"
                     Grid.Column="0"
                     Height="46"
                     VerticalContentAlignment="Center"
                     FontSize="14"
                     Padding="8"
                     BorderBrush="#CBD5E1"
                     BorderThickness="1"
                     KeyDown="InputTextBox_KeyDown" />

            <Button x:Name="HelpButton"
                    Grid.Column="1"
                    Width="110"
                    Height="46"
                    Margin="10,0,10,0"
                    Content="Help"
                    Background="#0F172A"
                    Foreground="White"
                    FontWeight="Bold"
                    Click="HelpButton_Click" />

            <Button x:Name="SendButton"
                    Grid.Column="2"
                    Width="130"
                    Height="46"
                    Content="Send"
                    Background="#22C55E"
                    Foreground="White"
                    FontWeight="Bold"
                    Click="SendButton_Click" />
        </Grid>
    </Grid>
</Window>
